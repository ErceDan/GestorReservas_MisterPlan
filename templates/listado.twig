{% extends 'base.twig' %}{% block title %}Reservas{% endblock %}{% block content %}
<h1>Reservas</h1><p id="notice" role="status"></p>
<form id="filters"><label>Estado <select name="estado"><option value="">Todos</option><option value="pendiente">Pendiente</option><option value="confirmada">Confirmada</option><option value="cancelada">Cancelada</option></select></label><label>Desde <input type="date" name="desde"></label><label>Hasta <input type="date" name="hasta"></label><label>Huésped <input name="q"></label><button>Filtrar</button></form>
<section><h2>Nueva reserva</h2><form id="create"><label>Huésped <input name="nombre_huesped" required maxlength="120"></label><label>Email <input name="email_huesped" type="email" required></label><label>Alojamiento <input name="nombre_alojamiento" required maxlength="150"></label><label>Entrada <input name="fecha_entrada" type="date" required></label><label>Salida <input name="fecha_salida" type="date" required></label><label>Importe <input name="importe" type="number" min="0.01" step="0.01" required></label><label>Notas <textarea name="notas"></textarea></label><button>Crear reserva</button></form></section>
<section aria-live="polite"><h2>Listado</h2><table><thead><tr><th>Huésped</th><th>Alojamiento</th><th>Estancia</th><th>Estado</th><th>Importe</th><th>Acciones</th></tr></thead><tbody id="reservas">{% for reserva in reservas %}<tr><td><a href="/reservas/{{ reserva.id }}">{{ reserva.nombreHuesped }}</a></td><td>{{ reserva.nombreAlojamiento }}</td><td>{{ reserva.fechaEntrada|date('d/m/Y') }} – {{ reserva.fechaSalida|date('d/m/Y') }}</td><td>{{ reserva.estado.value }}</td><td>{{ reserva.importe|number_format(2, ',', '.') }} €</td><td>{% if reserva.estado.value != 'cancelada' %}<button data-cancelar="{{ reserva.id }}">Cancelar</button>{% endif %}</td></tr>{% else %}<tr><td colspan="6">No hay reservas.</td></tr>{% endfor %}</tbody></table></section>{% endblock %}
