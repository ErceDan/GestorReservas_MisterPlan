{% extends 'base.twig' %}{% block title %}Reserva #{{ reserva.id }}{% endblock %}{% block content %}<a href="/">← Volver</a><h1>Reserva #{{ reserva.id }}</h1><dl><dt>Huésped</dt><dd>{{ reserva.nombreHuesped }}</dd><dt>Email</dt><dd>{{ reserva.emailHuesped }}</dd><dt>Alojamiento</dt><dd>{{ reserva.nombreAlojamiento }}</dd><dt>Estancia</dt><dd>{{ reserva.fechaEntrada|date('d/m/Y') }} – {{ reserva.fechaSalida|date('d/m/Y') }}</dd><dt>Estado</dt><dd>{{ reserva.estado.value }}</dd><dt>Importe</dt><dd>{{ reserva.importe|number_format(2, ',', '.') }} €</dd><dt>Notas</dt><dd>{{ reserva.notas|default('—') }}</dd></dl><h2>Historial</h2><ol>{% for evento in eventos %}<li><time>{{ evento.fechaCreacion|date('d/m/Y H:i') }}</time> — {{ evento.descripcion }}</li>{% endfor %}</ol>{% endblock %}
