Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:src|vendor|database|tests)/ - [F,L,NC]
    RewriteRule ^(?:\.env|bootstrap\.php|composer\.(?:json|lock)|phpunit\.xml)$ - [F,L,NC]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>
